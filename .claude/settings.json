{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/beads-session-start.sh",
            "type": "command",
            "statusMessage": "Syncing beads\u2026"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "echo '=== Nodes ===' && kubectl get nodes --no-headers 2>/dev/null | awk '{print $1, $2, $5}' && echo '=== Flux (not ready) ===' && flux get all -A 2>/dev/null | grep -Ev 'True|Succeeded|^NAMESPACE|^$' || echo '(all reconciled)'",
            "statusMessage": "Checking cluster state\u2026",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}
